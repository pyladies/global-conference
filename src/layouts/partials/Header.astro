---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
---

<header class="header pt-6">
  <nav class="relative flex max-w-[1260px] flex-wrap items-center justify-between site-container">
    <!-- logo -->
    <div class="order-none">
      <Logo />
    </div>
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      id="show-button"
      for="nav-toggle"
      class="order-2 flex cursor-pointer items-center text-black md:order-1 md:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
    </label>
    <label
      id="hide-button"
      for="nav-toggle"
      class="order-2 hidden cursor-pointer items-center text-black md:order-1"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->

    <ul
      id="nav-menu"
      class="order-3 hidden w-full text-center md:order-1 md:flex md:w-auto md:text-left"
    >
      {
        main.map((menu) => (
          <>
            {menu.hasChildren ? (
              <li class="group relative mx-1 cursor-pointer">
                <span class="inline-flex items-center p-3 text-lg font-semibold text-dark transition hover:text-primary md:p-4">
                  {menu.name}
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </span>
                <ul class="z-10 hidden rounded-lg bg-white px-6 py-3 shadow-[0_10px_30px_rgba(22,28,45,0.1)] transition group-hover:block md:invisible md:absolute md:block md:opacity-0 md:group-hover:visible md:group-hover:opacity-100">
                  {menu.children?.map((child) => (
                    <li class="mb-1">
                      <a
                        href={child.url}
                        class="block min-w-[150px] py-1 text-[17px] font-semibold text-dark transition hover:text-primary"
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
                <li class="mx-1">
                  <a
                    href={menu.url}
                    class="block p-3 text-lg font-semibold text-dark transition hover:text-primary md:p-4"
                  >
                    {menu.name}
                  </a>
                </li>
            )}
          </>
        ))
      }
    </ul>
    <div class="order-1 ml-auto flex md:order-2 md:ml-0">
      <a
        class="mr-4 inline-block cursor-pointer p-2 text-xl text-dark transition hover:text-primary md:mr-0"
        href="/search"
        title="seach"
        aria-label="seach"
      >
        <IoSearch />
      </a>
    </div>
  </nav>
</header>
